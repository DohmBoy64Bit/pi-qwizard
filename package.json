    "pi",
    "questions",
    "qna",
    "wizard",
    "questionnaire",
    "interactive",
    "tui"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DohmBoy64Bit/pi-qwizard.git"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "^0.85.1",
    "typebox": "^1.3.7"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
